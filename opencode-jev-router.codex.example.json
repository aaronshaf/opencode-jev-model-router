{
  "$schema": "https://github.com/aaronshaf/opencode-jev-model-router/schemas/config.schema.json",
  "enabled": true,
  "allowProjectModels": false,
  "tiers": {
    "fast": {
      "model": "openai/gpt-5-mini",
      "aliases": ["fast", "flash", "mini"],
      "fallbacks": ["openai/gpt-5.1-codex"]
    },
    "balanced": {
      "model": "openai/gpt-5.1-codex",
      "aliases": ["balanced", "codex"],
      "fallbacks": ["openai/gpt-5.2"]
    },
    "strong": {
      "model": "openai/gpt-5.2",
      "aliases": ["strong"],
      "fallbacks": ["openai/gpt-5.1-codex"]
    },
    "long": {
      "model": "openai/gpt-5.2",
      "enabled": false,
      "aliases": ["long"],
      "fallbacks": ["openai/gpt-5.1-codex"]
    }
  },
  "routing": {
    "failOpen": true,
    "maxPromptBytes": 16384,
    "timeoutMs": 1500,
    "deadlineMs": 3000,
    "maxRetries": 1,
    "minimumConfidence": 0.3,
    "uncertainCeiling": "balanced",
    "downgradeMaxContextTokens": 20000
  },
  "quota": {
    "cooldownHours": 5
  },
  "history": {
    "enabled": true,
    "retainPrompt": false,
    "maxEntries": 20
  },
  "echoRouting": true
}
