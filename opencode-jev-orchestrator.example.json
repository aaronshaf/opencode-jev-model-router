{
  "$schema": "https://github.com/aaronshaf/opencode-jev-orchestrator/schemas/config.schema.json",
  "enabled": true,
  "allowProjectModels": false,
  "tiers": {
    "fast": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "aliases": [
        "fast",
        "flash",
        "muse"
      ],
      "fallbacks": [
        "opencode-go/glm-5.3-flash",
        "opencode-go/mimo-v2.5"
      ]
    },
    "balanced": {
      "model": "opencode-go/mimo-v2.5",
      "aliases": [
        "balanced"
      ],
      "fallbacks": [
        "opencode-go/muse-spark-1.3-contributor",
        "opencode-go/deepseek-v4.1-flash",
        "opencode-go/qwen3.7-plus"
      ]
    },
    "strong": {
      "model": "opencode-go/gpt-5.6-luna",
      "aliases": [
        "strong",
        "luna"
      ],
      "fallbacks": [
        "opencode-go/kimi-k2.7-code",
        "opencode-go/qwen3.7-plus"
      ]
    },
    "long": {
      "model": "opencode-go/kimi-k3",
      "enabled": false,
      "aliases": [
        "long",
        "kimi",
        "k3"
      ],
      "fallbacks": [
        "opencode-go/kimi-k2.7-code"
      ]
    }
  },
  "routing": {
    "failOpen": true,
    "maxPromptBytes": 16384,
    "timeoutMs": 1500,
    "deadlineMs": 3000,
    "maxRetries": 1,
    "minimumConfidence": 0.3,
    "uncertainCeiling": "balanced"
  },
  "quota": {
    "cooldownHours": 5
  },
  "history": {
    "enabled": true,
    "retainPrompt": false,
    "maxEntries": 20
  },
  "echoRouting": true,
  "orchestration": {
    "mode": "subagents",
    "parentTier": "fast",
    "maxConcurrentChildren": 3,
    "escalateOn": [
      "strong",
      "long"
    ]
  }
}
