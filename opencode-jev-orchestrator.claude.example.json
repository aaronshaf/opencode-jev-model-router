{
  "$schema": "https://github.com/aaronshaf/opencode-jev-orchestrator/schemas/config.schema.json",
  "enabled": true,
  "allowProjectModels": false,
  "tiers": {
    "fast": {
      "model": "anthropic/claude-haiku-4-20250514",
      "aliases": [
        "fast",
        "flash",
        "haiku"
      ],
      "fallbacks": [
        "anthropic/claude-sonnet-4-20250514"
      ]
    },
    "balanced": {
      "model": "anthropic/claude-sonnet-4-20250514",
      "aliases": [
        "balanced",
        "sonnet"
      ],
      "fallbacks": [
        "anthropic/claude-opus-4-20250514"
      ]
    },
    "strong": {
      "model": "anthropic/claude-opus-4-20250514",
      "aliases": [
        "strong",
        "opus",
        "claude"
      ],
      "fallbacks": [
        "anthropic/claude-sonnet-4-20250514"
      ]
    },
    "long": {
      "model": "anthropic/claude-opus-4-20250514",
      "enabled": false,
      "aliases": [
        "long"
      ],
      "fallbacks": [
        "anthropic/claude-sonnet-4-20250514"
      ]
    }
  },
  "routing": {
    "failOpen": true,
    "maxPromptBytes": 16384,
    "timeoutMs": 1500,
    "deadlineMs": 3000,
    "maxRetries": 1,
    "minimumConfidence": 0.3,
    "uncertainCeiling": "balanced",
    "downgradeMaxContextTokens": 100000
  },
  "quota": {
    "cooldownHours": 5
  },
  "history": {
    "enabled": true,
    "retainPrompt": false,
    "maxEntries": 20
  },
  "echoRouting": true,
  "orchestration": {
    "mode": "subagents",
    "parentTier": "balanced",
    "maxConcurrentChildren": 3,
    "escalateOn": [
      "strong",
      "long"
    ]
  }
}
